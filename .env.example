# 복사해서 .env 로 사용 (.env 는 커밋 금지). 실제 값은 팀 채널로 공유.
DATABASE_URL=mysql+asyncmy://teamup:change-me@localhost:3306/teamup
TEST_DATABASE_URL=mysql+asyncmy://teamup:change-me@localhost:3306/teamup_test
JWT_SECRET=change-me
DEEPSEEK_API_KEY=
KAKAO_MAP_KEY=
ENV=local
CORS_ORIGINS=["http://localhost:5173"]
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root
GRAFANA_ADMIN_PASSWORD=change-me
# /metrics 보호 토큰. 비우면 local에서만 열린다. 만들기: openssl rand -hex 32 (docs/security/README.md B 절)
METRICS_TOKEN=
