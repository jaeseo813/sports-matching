# 운영(공개) 서버용 예시. 복사해서 서버의 환경 변수로 넣는다 (이 파일에 실제 값을 넣어 커밋하지 않는다).
# 값이 개발용 그대로면 서버가 시작되지 않는다 (backend/app/core/config.py). 자세한 순서는 docs/deploy.md.
ENV=production

# 32자 이상 무작위 값: openssl rand -hex 32  (바꾸면 모든 사용자가 다시 로그인해야 한다)
JWT_SECRET=
# 운영 DB. 비밀번호는 개발용(change-me)과 달라야 한다
DATABASE_URL=mysql+asyncmy://teamup:<DB 비밀번호>@<DB 주소>:3306/teamup
# 화면 주소만 (localhost 금지)
CORS_ORIGINS=["https://<화면 주소>"]

# 챗봇. 비우면 챗봇만 꺼지고 서비스는 필터로 동작한다. 운영용 키를 따로 발급해 사용량 한도를 건다
DEEPSEEK_API_KEY=
# /metrics 보호 토큰: openssl rand -hex 32. 비우면 운영에서는 항상 401
METRICS_TOKEN=
# 앞단 프록시(로드밸런서·nginx)의 주소. 실제 접속 IP를 읽어 레이트리밋에 쓴다
FORWARDED_ALLOW_IPS=<프록시 IP>
